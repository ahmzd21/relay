datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  fullName           String
  passwordHash       String?
  avatar             String?
  provider           String              @default("email")
  providerAccountId  String?
  emailVerified      DateTime?
  settings           Json                @default("{}")
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  twoFactorBackupCodes String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  memberships        WorkspaceMember[]
  verificationTokens VerificationToken[]
  pushSubscriptions  PushSubscription[]
  externalMeetings   ExternalMeeting[]

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  type      String   @default("EMAIL_VERIFICATION") // EMAIL_VERIFICATION | PASSWORD_RESET
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  type             WorkspaceType     @default(PERSONAL)
  subscriptionTier String            @default("FREE")
  settings         Json              @default("{}")
  minutesUsed      Int               @default(0)
  minutesLimit     Int               @default(2000)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          WorkspaceMember[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  token      String
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

enum ExternalMeetingStatus {
  VALIDATING
  CONNECTING
  WAITING_ROOM
  PASSCODE_REQUIRED
  REJECTED
  IN_CALL
  PROCESSING
  TRANSLATED
  ENDED
  FAILED
}

model ExternalMeeting {
  id                 String                @id @default(cuid())
  userId             String
  platform           String                // "zoom" | "google_meet" | "teams"
  meetingUrl          String
  nativeMeetingId    String?               // e.g. Zoom numeric meeting ID
  passcode           String?
  botSessionId       String?               // Vexa bot session ID
  botName            String                @default("Relay AI Assistant")
  title              String                @default("External Meeting")
  status             ExternalMeetingStatus @default(CONNECTING)
  statusDetail       String?               // e.g. "Waiting for host to admit bot from Zoom lobby"
  claimedSpeakerName String?               // e.g. "Elias Thompson" - which participant is the Relay user
  userInMeeting      Boolean               @default(false)
  hearingLang        String                @default("en")  // user wants to HEAR in this language
  speakingLang       String                @default("en")  // user's voice translated INTO this for the call
  summary            String?               @db.Text
  actionItems        Json                  @default("[]")
  transcript         Json                  @default("[]")  // [{speaker, text, timestamp, translatedText, isSelf}]
  participants       Json                  @default("[]")  // [{name, isSelf, isActive}]
  languages          String[]              @default(["en"])
  duration           String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

