datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  fullName           String
  passwordHash       String?
  avatar             String?
  provider           String              @default("email")
  providerAccountId  String?
  emailVerified      DateTime?
  settings           Json                @default("{}")
  twoFactorEnabled   Boolean             @default(false)
  twoFactorSecret    String?
  twoFactorBackupCodes String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  memberships        WorkspaceMember[]
  sentInvites        Invite[] @relation("InviteCreator")
  verificationTokens VerificationToken[]
  pushSubscriptions  PushSubscription[]
  externalMeetings   ExternalMeeting[]
  channelMemberships ChannelMember[]
  channelMessages    ChannelMessage[]
  createdChannels    Channel[]            @relation("ChannelCreator")
  channelMeetings    ChannelMeeting[]     @relation("MeetingCreator")
  nativeMeetings     NativeMeeting[]      @relation("NativeMeetingCreator")
  sentMentions       ChannelMention[]
  scheduledMeetings  ScheduledMeeting[]   @relation("ScheduledMeetingCreator")

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  type      String   @default("EMAIL_VERIFICATION") // EMAIL_VERIFICATION | PASSWORD_RESET
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id               String            @id @default(cuid())
  name             String
  type             WorkspaceType     @default(PERSONAL)
  subscriptionTier String            @default("FREE")
  settings         Json              @default("{}")
  minutesUsed      Int               @default(0)
  minutesLimit     Int               @default(2000)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  members          WorkspaceMember[]
  invites          Invite[]
  channels         Channel[]
  nativeMeetings   NativeMeeting[]
  scheduledMeetings ScheduledMeeting[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Invite {
  id          String       @id @default(cuid())
  workspaceId String
  email       String
  role        MemberRole   @default(MEMBER)
  invitedById String
  token       String       @unique
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InviteCreator", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([workspaceId, email])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  token      String
  deviceInfo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

enum ChannelRole {
  OWNER
  ADMIN
  MEMBER
}

enum ExternalMeetingStatus {
  VALIDATING
  CONNECTING
  WAITING_ROOM
  PASSCODE_REQUIRED
  REJECTED
  IN_CALL
  PROCESSING
  TRANSLATED
  ENDED
  FAILED
}

model ExternalMeeting {
  id                 String                @id @default(cuid())
  userId             String
  platform           String                // "zoom" | "google_meet" | "teams"
  meetingUrl          String
  nativeMeetingId    String?               // e.g. Zoom numeric meeting ID
  passcode           String?
  botSessionId       String?               // Vexa bot session ID
  botName            String                @default("Relay AI Assistant")
  title              String                @default("External Meeting")
  status             ExternalMeetingStatus @default(CONNECTING)
  statusDetail       String?               // e.g. "Waiting for host to admit bot from Zoom lobby"
  claimedSpeakerName String?               // e.g. "Elias Thompson" - which participant is the Relay user
  userInMeeting      Boolean               @default(false)
  hearingLang        String                @default("en")  // user wants to HEAR in this language
  speakingLang       String                @default("en")  // user's voice translated INTO this for the call
  summary            String?               @db.Text
  actionItems        Json                  @default("[]")
  transcript         Json                  @default("[]")  // [{speaker, text, timestamp, translatedText, isSelf}]
  participants       Json                  @default("[]")  // [{name, isSelf, isActive}]
  languages          String[]              @default(["en"])
  duration           String?
  durationMinutes    Int?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Channel {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  description String?
  settings    Json             @default("{}")
  createdBy   String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User              @relation("ChannelCreator", fields: [createdBy], references: [id])
  members   ChannelMember[]
  messages  ChannelMessage[]
  meetings  ChannelMeeting[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ChannelMember {
  id         String      @id @default(cuid())
  channelId  String
  userId     String
  role       ChannelRole @default(MEMBER)
  lastReadAt DateTime?
  joinedAt   DateTime    @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model ChannelMessage {
  id         String               @id @default(cuid())
  channelId  String
  userId     String
  content    String               @db.Text
  replyToId  String?
  editedAt   DateTime?
  deletedAt  DateTime?
  createdAt  DateTime             @default(now())

  channel     Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo     ChannelMessage?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     ChannelMessage[]     @relation("MessageReplies")
  mentions    ChannelMention[]
  attachments MessageAttachment[]

  @@index([channelId, createdAt])
  @@index([userId])
}

model ChannelMention {
  id        String @id @default(cuid())
  messageId String
  userId    String

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  fileSize  Int
  mimeType  String
  url       String
  createdAt DateTime @default(now())

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChannelMeeting {
  id              String    @id @default(cuid())
  channelId       String
  createdById     String
  title           String
  meetingType     String
  meetingUrl      String?
  roomName        String?
  status          String    @default("starting")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  participantCount Int      @default(0)
  language        String?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creator User    @relation("MeetingCreator", fields: [createdById], references: [id])

  @@index([channelId, startedAt])
}

model NativeMeeting {
  id              String    @id @default(cuid())
  title           String    @default("Native Meeting")
  roomName        String    @unique
  createdById     String
  workspaceId     String?
  status          String    @default("active")  // active | ended | failed
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  participantCount Int      @default(0)
  languages       String[]  @default(["en"])
  language        String?
  summary         String?   @db.Text
  actionItems     Json      @default("[]")
  transcript      Json      @default("[]")
  durationMinutes Int?

  creator   User           @relation("NativeMeetingCreator", fields: [createdById], references: [id])
  workspace Workspace?     @relation(fields: [workspaceId], references: [id])

  @@index([createdById, startedAt])
  @@index([workspaceId, startedAt])
}

model ScheduledMeeting {
  id          String    @id @default(cuid())
  title       String
  scheduledAt DateTime
  duration    String    @default("30m")
  platform    String    @default("Native") // Native | Zoom | Google Meet | Teams
  status      String    @default("upcoming") // upcoming | ended | cancelled
  createdById String
  workspaceId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator   User       @relation("ScheduledMeetingCreator", fields: [createdById], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([createdById, scheduledAt])
  @@index([workspaceId, scheduledAt])
}

