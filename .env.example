# ── Environment reference ────────────────────────────────────────────────────
# The API (apps/api) reads the root `.env` file  (dev: `tsx watch --env-file=../../.env`).
# The web app (apps/web) reads `apps/web/.env.local`  (Next.js auto-loads it).
# Copy this file to `.env` (API) and the relevant values into `apps/web/.env.local`.

# ── Postgres ────────────────────────────────────────────────────────────────
# Local dev: docker-compose runs postgres:16-alpine with these credentials.
# Production: set to your managed Postgres connection string (Neon/self-host).
DATABASE_URL="postgresql://relay:relay@localhost:5432/relay"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Strong random string (min 32 chars) — signs session + 2FA tokens. No fallback:
# the API and the web middleware fail closed without it. Must match across API
# and web so cookies verify correctly.
JWT_SECRET="change_me_to_a_secure_random_string_at_least_32_chars"

# Google OAuth (backend) — OAuth client ID used by the API's google-auth-library.
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# ── API / app URLs ───────────────────────────────────────────────────────────
# Where the Next.js web app lives (CORS + redirect URLs in the API).
FRONTEND_URL="http://localhost:3000"
# Port the Express API listens on.
PORT=4000
# URL the web app uses to reach the API directly.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ── Email ────────────────────────────────────────────────────────────────────
# "mailpit" for local dev (see docker-compose), "resend" for production.
EMAIL_PROVIDER="mailpit"
MAILPIT_HOST="localhost"
MAILPIT_PORT="1025"
MAILPIT_FROM="Relay <relay@localhost>"
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="Relay <onboarding@resend.dev>"

# ── Cloudinary (avatars/uploads) ────────────────────────────────────────────
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# ── Firebase Admin SDK (backend push notifications) ─────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Alternative to the three vars above:
# FIREBASE_SERVICE_ACCOUNT_PATH="/path/to/service-account.json"

# ── Firebase client (web push + auth — NEXT_PUBLIC, safe to expose) ─────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# VAPID key for web push (shown in the Firebase console). Required to mint
# messaging tokens; without it the service worker cannot register for pushes.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Cloud for dev (LiveKit Cloud), self-hosted server for production.
# The docker-compose dev server uses devkey/secret — matches these defaults.
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
# Optional: pin the node IP advertised by the docker-compose LiveKit server,
# e.g. LIVEKIT_NODE_IP=192.168.18.58
# LIVEKIT_NODE_IP=""

# ── Translation agent (apps/translation-agent) ──────────────────────────────
DEEPGRAM_API_KEY=""
DEEPL_API_KEY=""
GEMINI_API_KEY=""
ELEVENLABS_API_KEY=""
